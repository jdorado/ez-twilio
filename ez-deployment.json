{
  "schemaVersion": 2,
  "services": {
    "twilio": {
      "buildTarget": "runtime",
      "volumes": {"profile": "/state/twilio", "ipc": "/plugins/twilio"},
      "command": ["node", "/app/bin/ez-twilio.mjs", "serve"],
      "environment": {"EZ_TWILIO_SERVICE": "1"},
      "healthcheck": ["node", "/app/bin/ez-twilio.mjs", "health"],
      "memoryMiB": 128
    }
  },
  "commands": {"twilio": {"service": "twilio", "argv": ["node", "/app/bin/ez-twilio.mjs"]}},
  "exports": {"backup": {"service": "twilio", "path": "/state/twilio/backup.sqlite"}}
}
